<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="Sentry" />
    <PackageReference Include="Sentry.Hangfire" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Tesseract" />
    <PackageReference Include="Stripe.net" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
    <PackageReference Include="Hangfire.MemoryStorage" />
    <!-- Pin transitive Newtonsoft.Json (Hangfire dependency) above the
         GHSA-5crp-9r3c-p9vr advisory cut-off (11.0.1 → 13.0.3). -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaxReader.Domain\TaxReader.Domain.csproj" />
    <ProjectReference Include="..\TaxReader.Application\TaxReader.Application.csproj" />
  </ItemGroup>

  <!-- TesseractEnginePool exposes internal members (EngineFactoryOverride,
       LiveEngineCount) for Layer A unit tests that cover channel mechanics
       without the native Tesseract dependency. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TaxReader.UnitTests" />
  </ItemGroup>

</Project>
