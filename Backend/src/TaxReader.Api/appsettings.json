{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=belegpilot;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Sentry": {
    "Dsn": ""
  },
  "Tesseract": {
    "TessDataPath": "/usr/share/tesseract-ocr/5/tessdata",
    "Language": "deu+eng"
  },
  "AllowedHosts": "*"
}
