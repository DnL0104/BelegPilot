# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=taxreader
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Domain (used by Caddy for automatic HTTPS) ────────────────────────────────
# For local testing: localhost
# For production:    yourdomain.com
DOMAIN=localhost

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-strong-random-secret-minimum-32-characters

# ── Refresh Token ─────────────────────────────────────────────────────────────
# HMAC-SHA256 pepper for refresh-token hashing (256-bit, server-side secret).
# Rotating this value invalidates ALL existing refresh tokens (forces re-login).
# Generate with: openssl rand -base64 32
REFRESHTOKEN_HASHKEY=

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_COST_PER_CLASSIFICATION=1

# ── Sentry ────────────────────────────────────────────────────────────────────
# Backend DSN — EU region (sentry.eu.io). Leave blank to disable.
SENTRY_DSN_BACKEND=

# Frontend Sentry — disabled in Phase 1 until TTDSG cookie banner lands (Phase 6).
# Frontend DSN is a public symbol (ships in JS bundle). Backend DSN is private.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=

# ── Hangfire ──────────────────────────────────────────────────────────────────
# Comma-separated list of existing user emails to promote to admin role at startup.
# Required to access the /hangfire dashboard. Example: HANGFIRE_SEEDADMINEMAILS=you@example.com
HANGFIRE_SEEDADMINEMAILS=

# ── Tesseract OCR pool ────────────────────────────────────────────────────────
# Number of TesseractEngine instances in the pool (D-16). 3 fits 100-500 user scale.
# Hangfire WorkerCount is auto-aligned with this value — never set > here.
TESSERACT_POOLSIZE=3
