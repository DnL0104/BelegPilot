# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=taxreader
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Domain (used by Caddy for automatic HTTPS) ────────────────────────────────
# For local testing: localhost
# For production:    yourdomain.com
DOMAIN=localhost

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-strong-random-secret-minimum-32-characters

# ── Refresh Token ─────────────────────────────────────────────────────────────
# HMAC-SHA256 pepper for refresh-token hashing (256-bit, server-side secret).
# Rotating this value invalidates ALL existing refresh tokens (forces re-login).
# Generate with: openssl rand -base64 32
REFRESHTOKEN_HASHKEY=

# ── Anthropic AI ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_COST_PER_CLASSIFICATION=1

# ── Sentry ────────────────────────────────────────────────────────────────────
# Backend DSN — EU region (sentry.eu.io). Leave blank to disable.
SENTRY_DSN_BACKEND=

# Frontend Sentry — disabled in Phase 1 until TTDSG cookie banner lands (Phase 6).
# Frontend DSN is a public symbol (ships in JS bundle). Backend DSN is private.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=

# ── Hangfire ──────────────────────────────────────────────────────────────────
# Comma-separated list of existing user emails to promote to admin role at startup.
# Required to access the /hangfire dashboard. Example: HANGFIRE_SEEDADMINEMAILS=you@example.com
HANGFIRE_SEEDADMINEMAILS=

# ── Tesseract OCR pool ────────────────────────────────────────────────────────
# Number of TesseractEngine instances in the pool (D-16). 3 fits 100-500 user scale.
# Hangfire WorkerCount is auto-aligned with this value — never set > here.
TESSERACT_POOLSIZE=3

# ── Upload blob storage ───────────────────────────────────────────────────────
# Path inside the api container where upload bytes are buffered until Hangfire
# finishes processing them. Mounted from a Docker named volume so bytes survive
# container restarts (retry path depends on this). Default in dev: system temp dir.
UPLOADSTORAGE_PATH=/var/lib/taxreader/uploads

# ── Stripe Payment Provider (Phase 5 — PAY-01) ──────────────────────────────
# Create a Stripe account and find your keys at https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_ / pk_test_; live keys start with sk_live_ / pk_live_
Stripe__SecretKey=sk_test_YOUR_SECRET_KEY_HERE
Stripe__PublishableKey=pk_test_YOUR_PUBLISHABLE_KEY_HERE
# Get from https://dashboard.stripe.com/webhooks after creating a webhook endpoint
# pointing to https://yourdomain.com/webhooks/stripe
# Events to register: checkout.session.completed, charge.refunded
Stripe__WebhookSecret=whsec_YOUR_WEBHOOK_SECRET_HERE
# Set to true to skip Stripe and directly credit tokens (demos/screenshots only)
Stripe__DemoMode=false
# Frontend base URL — used for success_url and cancel_url in Checkout sessions
Stripe__AppBaseUrl=http://localhost:3000
# Stripe Price IDs — create manually in Stripe Dashboard (Products + Prices)
# Uncomment and fill in after creating your Stripe products:
# Stripe__PricePacks__0__Credits=50
# Stripe__PricePacks__0__StripePriceId=price_XXXXXXXXXXXXXXXXXXXXXXXX
# Stripe__PricePacks__1__Credits=200
# Stripe__PricePacks__1__StripePriceId=price_XXXXXXXXXXXXXXXXXXXXXXXX
# Stripe__PricePacks__2__Credits=500
# Stripe__PricePacks__2__StripePriceId=price_XXXXXXXXXXXXXXXXXXXXXXXX
# Local webhook forwarding during development:
#   stripe listen --forward-to http://localhost:5190/webhooks/stripe
